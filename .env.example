# Copy to `.env` for local development. Do not commit real secrets.

# -----------------------------------------------------------------------------
# Database (Prisma + SQLite for local dev)
# -----------------------------------------------------------------------------
# Local dev (default). On Vercel, use file:./prisma/prod.db so migrate/seed run during build.
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Admin dashboard (`/admin`) — required for login
# -----------------------------------------------------------------------------
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="use-a-long-random-string-at-least-32-chars"

# -----------------------------------------------------------------------------
# Public site URL (metadata, Open Graph base)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Optional: Home hero — YouTube embed
# Set to the video ID only (the part after v= in a youtube.com/watch URL).
# Example: for https://www.youtube.com/watch?v=dQw4w9WgXcQ use dQw4w9WgXcQ
# -----------------------------------------------------------------------------
NEXT_PUBLIC_INTRO_VIDEO_ID=""

# -----------------------------------------------------------------------------
# Optional: Schedule page — Cal.com or Calendly embed
# Paste the full iframe `src` URL from your booking provider so `/schedule`
# can show the calendar widget.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CAL_EMBED_URL=""

# -----------------------------------------------------------------------------
# Optional: Recruiter Portal — “Download resume” button
# Same-origin path (file in `public/`) or full HTTPS URL to a PDF.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RESUME_URL="/ilak_new.pdf"

# -----------------------------------------------------------------------------
# Optional: Daily summary email (`GET /api/cron/daily-summary`)
# Get an API key from https://resend.com — used to send the digest.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""

# “From” address must be a domain/address you’ve verified in Resend.
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Where Ilak receives the daily activity summary.
DAILY_SUMMARY_TO_EMAIL=""

# -----------------------------------------------------------------------------
# Optional: Protect the cron endpoint
# Send header: Authorization: Bearer <CRON_SECRET>
# Configure the same value in Vercel Cron / your scheduler.
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Ilak's general-Agent1 (`/agent`, `/api/agent/*`, `/api/mcp`)
# -----------------------------------------------------------------------------
AGENT_LLM_ENABLED="false"
AGENT_LLM_PROVIDER="openai"
AGENT_LLM_MODEL="gpt-4o-mini"
AGENT_LLM_TEMPERATURE="0.2"
AGENT_LLM_MAX_TOKENS="400"
AGENT_DEFAULT_BUDGET_SEC="600"
AGENT_DEFAULT_EXPIRY_DAYS="7"
AGENT_ZELLE_PHONE="309-363-7732"
AGENT_ZELLE_MEMO="AGENT1"
AGENT_PUBLIC_PRICE_USD="5"

# Server-only — optional Mode B paraphrase when AGENT_LLM_ENABLED=true
OPENAI_API_KEY=""
XAI_API_KEY=""
